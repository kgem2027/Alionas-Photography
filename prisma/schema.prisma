generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String     @id @default(cuid())
  name     String
  email    String     @unique
  password String?
  role     Role       @default(User)
  bookings Bookings[]
  reviews  Reviews[]
}

model Reviews {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  userId      String
  title       String?
  description String
  rating Int
  user        User     @relation(fields: [userId], references: [id])
}

model Bookings {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  serviceId     String
  userId        String
  streetAddress String
  zipCode String
  city String
  state String 
  accomodations String
  shootDate     DateTime
  endTime       DateTime
  status        BookingStatus @default(PENDING)
  googleEventId String?
  service       Service       @relation(fields: [serviceId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
}

model Service {
  id          String     @id @default(cuid())
  name        String
  price       Decimal    @db.Decimal(10, 2)
  description String?
  active      Boolean    @default(true)
  bookings    Bookings[]
}

enum Role {
  User
  Admin
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCLED
  COMPLETED
}
